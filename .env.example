# ==============================================================================
# SPORTS PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your production credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
# In production, DEBUG MUST BE False!
DEBUG=False

# Generate a strong, unique 50+ character secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-very-secure-random-secret-key-at-least-50-chars

# Comma-separated list of fully qualified domain names and IP addresses:
# Example: ALLOWED_HOSTS=sports.tamilnadu.gov.in,api.sports.gov.in,10.0.0.1
ALLOWED_HOSTS=sports.example.com,www.sports.example.com

# CSRF Trusted Origins for HTTPS form submissions (comma-separated):
# Example: CSRF_TRUSTED_ORIGINS=https://sports.example.com,https://www.sports.example.com
CSRF_TRUSTED_ORIGINS=https://sports.example.com

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# You can configure PostgreSQL in ONE of two ways:
#
# OPTION A: Single Connection URL (Recommended for 12-factor apps, Cloud & PaaS)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
#
# Examples:
# - Standard Production:
#   DATABASE_URL=postgresql://postgres_user:strong_password@db-cluster.us-east-1.rds.amazonaws.com:5432/sports_production?sslmode=require
#
# - AWS RDS / Aurora:
#   DATABASE_URL=postgresql://dbadmin:SecretPass123@sports-db.c123456789.ap-south-1.rds.amazonaws.com:5432/sports_db?sslmode=require
#
# - Supabase (Transaction Pooler - port 6543):
#   DATABASE_URL=postgresql://postgres.yourproject:YourPassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#   DB_DISABLE_SERVER_SIDE_CURSORS=True
#
# - Neon.tech:
#   DATABASE_URL=postgresql://user:password@ep-cool-sample-123456.ap-southeast-1.aws.neon.tech/sports_db?sslmode=require
#
# - Render / Railway / Fly.io:
#   DATABASE_URL=postgresql://user:pass@dpg-host-a.oregon-postgres.render.com/sports_db
#
DATABASE_URL=postgresql://sports_user:change_me_production_password@postgres.internal.net:5432/sports_db?sslmode=require

# ------------------------------------------------------------------------------
# OPTION B: Discrete Environment Variables (Used by Docker, Kubernetes, etc.)
# (Will be used if DATABASE_URL is not set)
# ------------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sports_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=postgres-cluster.internal
# DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. POSTGRESQL PRODUCTION TUNING & CONNECTION POOLING
# ------------------------------------------------------------------------------
# CONN_MAX_AGE: Persistent database connection lifetime in seconds.
# Reuses existing database connections across HTTP requests, significantly
# reducing TLS handshakes and connection overhead.
# - Production default: 600 (10 minutes)
# - Set to 0 if using an external connection pooler in session mode.
DB_CONN_MAX_AGE=600

# CONN_HEALTH_CHECKS: Verifies an existing persistent connection is still valid
# before reusing it. Prevents HTTP 500 errors if RDS/Neon closed idle sockets.
# - True (recommended for production)
DB_CONN_HEALTH_CHECKS=True

# DB_SSLMODE: SSL encryption requirement for PostgreSQL connections.
# Cloud hosts (RDS, Neon, Supabase, Azure, DigitalOcean) mandate SSL.
# Options: require | verify-ca | verify-full | prefer | disable
DB_SSLMODE=require

# DB_CONNECT_TIMEOUT: Timeout in seconds when establishing initial connection.
# Prevents web workers from hanging indefinitely if database host is down.
DB_CONNECT_TIMEOUT=10

# DB_DISABLE_SERVER_SIDE_CURSORS:
# Set to True when connecting through transaction poolers like PgBouncer
# or Supabase transaction pooler (port 6543) which do not support prepared statements / cursors.
DB_DISABLE_SERVER_SIDE_CURSORS=False
